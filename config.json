{
    "claude_model": "claude-opus-4-8",
    "claude_backend": "claude_code",
    "claude_command": "claude",
    "claude_code_model": "opus",
    "claude_code_max_turns": 12,
    "openai_model": "gpt-5.5",
    "coder_backend": "codex",
    "execution_profile": "autonomous",
    "codex_command": "codex",
    "codex_args": ["exec", "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "-m", "gpt-5.5"],
    "codex_profiles": {
        "autonomous": ["exec", "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "-m", "gpt-5.5"],
        "ci": ["exec", "--skip-git-repo-check", "--dangerously-bypass-approvals-and-sandbox", "-m", "gpt-5.5"]
    },
    "agent_retries": 1,
    "max_iterations": 5,
    "workspace_root": "workspace",
    "max_tokens_architect": 16000,
    "max_tokens_tester": 16000,
    "max_tokens_coder": 32000,
    "tester_max_file_bytes": 200000,
    "verification": {
        "enabled": true,
        "commands": [],
        "require_commands_for_clean": true,
        "timeout_seconds": 300
    }
}
